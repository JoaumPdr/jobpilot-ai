# JobPilot AI - Variáveis de Ambiente
# Copie para .env e preencha os valores reais

# Banco de dados PostgreSQL (Docker Compose)
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5433/jobpilot

# Banco de testes (opcional): default deriva de DATABASE_URL + sufixo _test.
# O banco é recriado pela suíte e nunca deve apontar para o banco de dev.
# TEST_DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5433/jobpilot_test

# Configuração da aplicação
APP_ENV=development
LOG_LEVEL=INFO

# LLM (Fase 3+) - configurar quando a fase começar
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# LLM_TIMEOUT=30
# LLM_MAX_TOKENS=4096
# LLM_BUDGET_USD=10.0

# Embeddings (Fase 2+) - opcional
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=

# Coletores de vagas (Fase 7+) - opcional
# JOB_SOURCE_GITHUB_TOKEN=
# JOB_SOURCE_LINKEDIN_TOKEN=